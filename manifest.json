{
  "id": "angelteich",
  "name": { "de": "Angelteich", "en": "Fishing Pond" },
  "version": "0.3.1",
  "languages": [
    "de",
    "en"
  ],
  "cover": "cover.svg",
  "description": {
    "de": "Reihum angeln am Familienteich: Fische fangen, im Laden verkaufen, bessere Ruten kaufen und das Sammelbuch füllen",
    "en": "Take turns fishing at the family pond: catch fish, sell them at the shop, buy better rods and fill your collection book"
  },
  "repository": "https://github.com/hearthbit/gamehearth-angelteich",
  "sdk": "^0.1.6",
  "license": {
    "code": "MIT",
    "assets": "CC0-1.0"
  },
  "mode": "turn-based",
  "players": {
    "min": 1,
    "max": 4
  },
  "server": true,
  "client": "dist/client",
  "roles": {
    "player": {
      "inputs": [
        "touch",
        "mouse",
        "keyboard"
      ],
      "screen": "small"
    }
  },
  "options": {
    "runden": {
      "label": {
        "de": "Runden",
        "en": "Rounds"
      },
      "type": "choice",
      "default": 5,
      "choices": [
        {
          "value": 3,
          "label": {
            "de": "3 Runden",
            "en": "3 rounds"
          }
        },
        {
          "value": 5,
          "label": {
            "de": "5 Runden",
            "en": "5 rounds"
          }
        },
        {
          "value": 8,
          "label": {
            "de": "8 Runden",
            "en": "8 rounds"
          }
        }
      ]
    }
  },
